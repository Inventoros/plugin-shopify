    "requires_php": "8.4",
    "main_file": "Plugin.php",
    "ui": {
        "entry": "plugin.js",
        "styles": ["plugin.css"]
    },
    "inventoros": {
        "official": true,
        "tier": "free",
        "namespace": "Inventoros\\Plugins\\Starter",
        "table_prefix": "plg_starter_",
